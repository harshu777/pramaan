# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://certadmin:certpass123@localhost:5432/certificate_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=certificate_db
DB_USER=certadmin
DB_PASSWORD=certpass123

# IPFS Configuration
IPFS_API=http://localhost:5001
IPFS_GATEWAY=http://localhost:8080

# Pinata Configuration (Alternative to local IPFS)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Web3 Storage Configuration (Alternative to local IPFS)
WEB3_STORAGE_TOKEN=your_web3_storage_token

# Blockchain Configuration
BLOCKCHAIN_RPC=http://localhost:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_KEY=your_private_key_for_issuer_wallet

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# QR Code Configuration
QR_BASE_URL=http://localhost:3000/validate

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100