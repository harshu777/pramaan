# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgres://username:password@localhost:5432/cert_management
# Or use SQLite for development
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/certificates.db

# Blockchain Configuration
BLOCKCHAIN_RPC=http://localhost:8545
PRIVATE_KEY=your-wallet-private-key
CONTRACT_ADDRESS=your-deployed-contract-address

# IPFS Configuration (Choose one)
# Option 1: Pinata
IPFS_SERVICE=pinata
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key

# Option 2: Web3.Storage
# IPFS_SERVICE=web3storage
# WEB3_STORAGE_TOKEN=your-web3-storage-token

# Option 3: Local IPFS Node
# IPFS_SERVICE=local
# IPFS_API_URL=http://localhost:5001

# Email Configuration
# Option 1: Gmail (requires app-specific password)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-specific-password

# Option 2: Custom SMTP
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@example.com
# EMAIL_PASSWORD=your-password

# Email Settings
EMAIL_FROM="Certificate Management System" <noreply@certmanagement.com>

# QR Code Configuration
QR_BASE_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changethis123

# Features
ENABLE_BLOCKCHAIN=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_BULK_UPLOAD=true